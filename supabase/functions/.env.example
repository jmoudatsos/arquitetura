# ─────────────────────────────────────────────────────────────────────────────
#  Segredos das Edge Functions (create-lead / notify-lead)
#  Copie para supabase/functions/.env, preencha e envie com:
#     npx supabase secrets set --env-file supabase/functions/.env
#  SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetadas pelo Supabase.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública do site (link "Abrir no painel" dentro do e-mail/WhatsApp)
SITE_URL=https://seusite.com.br

# Origens que podem chamar as funções direto do navegador (vazio = qualquer)
ALLOWED_ORIGINS=https://seusite.com.br,https://www.seusite.com.br

# Sal do hash de IP (anti-spam). Qualquer texto aleatório.
IP_HASH_SALT=troque-por-um-texto-aleatorio

# ── E-MAIL (Resend — https://resend.com) ──────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remetente de um domínio verificado no Resend.
# Para testar sem domínio: "Briefing <onboarding@resend.dev>" (só entrega para o e-mail da sua conta Resend).
NOTIFY_EMAIL_FROM=Briefing <briefing@seudominio.com.br>
# Destino padrão (separe vários por vírgula). O painel (Configurações) tem prioridade.
NOTIFY_EMAIL_TO=voce@seudominio.com.br

# ── WHATSAPP ─────────────────────────────────────────────────────────────────
# callmebot (grátis, avisa o SEU número) | meta (WhatsApp Cloud API) | twilio | none
WHATSAPP_PROVIDER=callmebot
# Número que recebe os avisos (DDI + DDD + número). O painel tem prioridade.
NOTIFY_WHATSAPP_TO=5548999999999

# CallMeBot (serviço gratuito e não oficial, ideal para avisar o PRÓPRIO número):
# siga https://www.callmebot.com/blog/free-api-whatsapp-messages/ — você envia uma mensagem de
# autorização pelo WhatsApp do número acima para o contato indicado na página e recebe a apikey.
CALLMEBOT_API_KEY=

# Meta WhatsApp Cloud API (oficial)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Template aprovado com 4 variáveis no corpo: {{1}} nome, {{2}} whatsapp, {{3}} ambientes, {{4}} link
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=pt_BR

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── AVANÇADO ─────────────────────────────────────────────────────────────────
# Segredo para chamar notify-lead por Database Webhook/automação (cabeçalho x-notify-secret)
NOTIFY_SECRET=
# false = create-lead NÃO notifica (use um Database Webhook em leads → notify-lead)
NOTIFY_ON_CREATE=true
# Limites anti-abuso
MAX_LEADS_PER_IP_10MIN=5
MAX_LEADS_PER_PHONE_HOUR=3
MAX_LEADS_PER_HOUR=100
