# ─────────────────────────────────────────────────────────────────────────────
#  Copie este arquivo para `.env` e preencha.
#  Sem as variáveis do Supabase o site sobe em MODO DEMONSTRAÇÃO
#  (dados de exemplo em memória, sem envio real de e-mail/WhatsApp).
# ─────────────────────────────────────────────────────────────────────────────

# URL pública do site (usada em links de e-mail, SEO e no WhatsApp)
SITE_URL=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ir para o navegador.
SUPABASE_ANON_KEY=

# Segredo para assinar o cookie de sessão do modo demonstração (gere um aleatório).
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Login do admin no MODO DEMONSTRAÇÃO (ignorado quando o Supabase está configurado).
# Em produção sem Supabase o login demo só é liberado se DEMO_ADMIN_PASSWORD for definido.
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
#  Segredos das Edge Functions — NÃO ficam neste arquivo em produção.
#  Configure com:  npx supabase secrets set --env-file supabase/functions/.env
#  (modelo em supabase/functions/.env.example)
# ─────────────────────────────────────────────────────────────────────────────
