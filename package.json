{
  "name": "architecture-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site institucional + briefing interativo de móveis planejados (React Router 7 + Vite + Tailwind 4 + Supabase).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "npm run build && npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:functions": "deno test --allow-env --allow-net --config tests/functions/deno.json tests/functions",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "seed:generate": "node scripts/generate-seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "isbot": "5.2.2",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
